# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# API Gateway URL
REACT_APP_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/dev

# Stripe Configuration (Get from https://dashboard.stripe.com/test/apikeys)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
REACT_APP_STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# Optional configurations
REACT_APP_BACKEND_DISABLED=false
